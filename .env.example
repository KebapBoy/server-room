# Copy to .env and adjust. .env is not in Git and, like this whole folder, not reachable by URL.
# Lists are comma-separated, maps are comma-separated name=value pairs.
# Service names are proxy conf file names without .subdomain.conf.
# Environment variables of the same name take precedence over this file (e.g. in a container).

# Domain whose subdomains SWAG serves (required)
BASE_DOMAIN=example.com

# Authelia as reached from inside the SWAG container
AUTHELIA_URL=http://authelia:9091

# Where pulling the plug leads (default: https://auth.<BASE_DOMAIN>/logout)
#LOGOUT_URL=https://auth.example.com/logout

# Active SWAG proxy confs
#PROXY_CONFS=/config/nginx/proxy-confs/*.subdomain.conf

# Services that are never shown
SKIPPED_SERVICES=auth

# Authelia group that sees all stacks and containers, also those without a domain
ADMIN_GROUP=admins

# Groups that see services without Authelia (own login only); per service: name=group1|group2
GROUPS_WITHOUT_AUTHELIA=admins
#GROUPS_WITHOUT_AUTHELIA_PER_SERVICE=jellyfin=admins|family

# Services whose proxy conf has no usable upstream: name=compose service (also the module label)
#SERVICE_CONTAINERS=dashboard=swag

# Services whose web UI does not live at /: name=path
#SERVICE_PATHS=pihole=/admin/

# Stack snapshot written by your own job (default: data/stacks.json next to index.php)
#SNAPSHOT_FILE=/config/www/start/data/stacks.json

# Seconds after which the stack snapshot counts as stale
SNAPSHOT_MAX_AGE=180
