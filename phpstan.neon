# PHPStan (just check)
parameters:
    level: 8
    paths:
        - index.php
        - page.html.php
        - docs/screenshots/capture/sample/router.php
    # The model is a tree of loose arrays (snapshot JSON, proxy confs); typing every shape adds
    # nothing to the checks that matter here
    ignoreErrors:
        - identifier: missingType.iterableValue
